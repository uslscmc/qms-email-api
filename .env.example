# Copy these values into the Vercel project's Environment Variables.
# DO NOT commit real secrets to git.

# Gmail SMTP (defaults shown; only SMTP_USER + SMTP_PASS are required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Gmail account used to send the notifications
SMTP_USER=qms@usls.edu.ph

# Gmail APP PASSWORD (16 chars). A normal account password will be rejected.
SMTP_PASS=

# Recipient of all notifications. Defaults to SMTP_USER when unset.
# Every notification is delivered to this single mailbox.
NOTIFY_TO=qms@usls.edu.ph
